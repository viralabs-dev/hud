[27.166365, "o", "\u001b[1;47H\u001b(B\u001b[0;1m\u001b[36mPASTA · projeto-exemplo · ao vivo \u001b[2;46H\u001b[39m4 arquivos de texto\u001b(B\u001b[0;2m · 4 hoje · 1 quadro(s)\u001b[94G\u001b(B\u001b[0m\u001b[33m2\u001b[2;112H\u001b(B\u001b[0;1m\u001b[31m1\u001b[4;64H\u001b[39m\u001b(B\u001b[0;2mfazer andam  bloq feito\u001b(B\u001b[m      \u001b[5;46HProjeto exemplo\u001b[68G1\u001b[33m     2\u001b(B\u001b[0;1m\u001b[31m     1\u001b[39m\u001b(B\u001b[m     1  \u001b[32m██\u001b[39m\u001b(B\u001b[0;2m░░░░░░░░░░  20%\u001b(B\u001b[m      \u001b[6;46H\u001b[21X\u001b[6;74H\u001b[38X\u001b[7;46H\u001b(B\u001b[0;1m\u001b[36mATENÇÃO\u001b[8;46H\u001b(B\u001b[0m\u001b[33m▶ Projeto exemplo \u001b[39m\u001b(B\u001b[mPágina de contato\u001b[9;48H\u001b[33mProjeto exemplo \u001b[39m\u001b(B\u001b[mTestes de acessibilidade          \u001b[10;46H\u001b(B\u001b[0;1m\u001b[31m■ Projeto exemplo \u001b[39m\u001b(B\u001b[mCertificado do domínio\u001b[15X\u001b[11;46H\u001b[51X\u001b[12d\u001b(B\u001b[0;1m\u001b[36mRECENTES\u001b[39m\u001b(B\u001b[m\u001b[41X\u001b[13;46H\u001b(B\u001b[0;2m agora  \u001b(B\u001b[mnotas\u001b[31X\u001b[14;46H\u001b(B\u001b[0;2m agora  \u001b(B\u001b[mroteiro\u001b(B\u001b[0;2m  docs\u001b[15;46H agora  \u001b(B\u001b[mKanban (Projeto exemplo)\u001b[16;54HREADME            \u001b[17;46H\u001b[16X\u001b[18d\u001b[14X\u001b[19d\u001b[23X\u001b[20;61H\u001b(B\u001b[0;2mprojeto-exemplo · varredura 1ms \u001b[22;48H\u001b(B\u001b[m/perfil leitura|completo · troca o perfil do agente do modo atual nesta\u001b[23;48H  sessão\u001b[59X\u001b[24;50Hleitura: Claude só lê o Vault, sem MCP · Codex em sandbox read-only ·\u001b[25;48H    OpenCode sem edição, bash e web\u001b[36X\u001b[26;50Hcompleto: o mesmo Claude Code / Codex / OpenCode do seu terminal\u001b[27;50H  (ferramentas, MCP, skills)\u001b[41X\u001b[28;46H"]
[27.166934, "o", "\u001b(B\u001b[0;1mSegurança\u001b(B\u001b[m\u001b[28X\u001b[29;48HSó rodam os comandos da lista: sem shell, PATH e ambiente fixos,  \u001b[30;50Htempo-limite e saída limitada.\u001b[31;46H  O HUD só escreve na pasta (o Vault ou a de /pasta) com /doc salvar:\u001b[32;48H  arquivos .md propostos, sem sair da pasta.\u001b[20X\u001b[33;48HTexto de fora tem as sequências de escape removidas.\u001b[34;46H\u001b[32mpasta: /tmp/hud-demo/projeto-exemplo · lembrada para a próxima vez\u001b[39m\u001b(B\u001b[m   \u001b[35;46H\u001b(B\u001b[0;2mclaude e codex e opencode agora trabalham e leem nesta pasta; conversa\u001b[36;46Hnova\u001b(B\u001b[m\u001b[50X\u001b[39;5H\u001b[36X"]
